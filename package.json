{
  "name": "mbbsinhungary-nextjs",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "@types/pg": "^8.11.5"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "node scripts/clean-next.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "dotenv -e .env -- npx ts-node --project tsconfig.json -e 'require(\"./prisma/seed.ts\")'",
    "seed:Qatar": "npx dotenv-cli -e .env -- npx tsx scripts/seed-Qatar.ts",
    "seed:Qatar:all": "npx dotenv-cli -e .env -- npx tsx scripts/seed-Qatar-comprehensive.ts",
    "seed:Qatar:universities": "npx dotenv-cli -e .env -- npx tsx scripts/seed-Qatar-universities.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
